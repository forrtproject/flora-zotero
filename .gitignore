# Zotero Plugin .gitignore

# Built XPI files
*.xpi

# Backup files
*.backup
*.old
*.bak
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# Node.js (if you add build tools later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Build artifacts
build/
dist/
.scaffold/
*.log

# Test output
*.test.js

# Environment files
.env
.env.local

# Temporary files
tmp/
temp/
*.tmp

# Debug files
debug.log

# Python (if you have any Python scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

# Documentation build artifacts
docs/_build/
docs/.doctrees/

# IDE specific
*.iml
.classpath

# Zip files (except XPI which is already listed)
*.zip

# Raw screen recordings - convert with scripts/encode-tutorial-video.sh and
# commit the resulting docs/media/*.mp4 instead (GitHub rejects files > 100 MB)
*.mov

# Old structure (if converting)
chrome-OLD-DELETE-LATER/
*.manifest-OLD

# Local GitHub Pages preview built by scripts/preview-pages.py
docs/.preview/

# Pages content assembled by scripts/build_docs.py (CI builds these; they are
# derived from README.md, Contributing.md and .github/RELEASE_GUIDE.md)
docs/index.md
docs/documentation/
docs/contributing/
docs/release-guide/
docs/update.json
